    "Merge adds items from the backup without touching what you have. Replace removes your current profiles, fragments, and custom sources first (System Default and built-in sources are kept).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge adds items from the backup without touching what you have. Replace removes your current profiles, fragments, and custom sources first (System Default and built-in sources are kept)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge adds items from the backup without touching what you have. Replace removes your current profiles, fragments, and custom sources first (System Default and built-in sources are kept)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Combinar añade los elementos de la copia de seguridad sin tocar los tuyos. Reemplazar elimina primero tus perfiles, fragmentos y fuentes personalizadas (se conservan System Default y las fuentes integradas)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fusionner ajoute les éléments de la sauvegarde sans toucher aux vôtres. Remplacer supprime d’abord vos profils, fragments et sources personnalisées (le profil System Default et les sources intégrées sont conservés)."
          }
        }
      }
