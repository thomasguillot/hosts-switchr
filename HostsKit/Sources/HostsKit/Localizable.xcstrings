{
  "sourceLanguage" : "en",
  "strings" : {
    "error.cacheHashMismatch" : {
      "comment" : "Shown when a cached blocklist file fails its SHA-256 integrity check. %@ is the source name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't apply — the cached copy of \"%@\" doesn't match its verified checksum (it may be corrupted or was modified). Refresh that source and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se puede aplicar: la copia en caché de «%@» no coincide con su suma de verificación (puede estar dañada o haberse modificado). Actualiza esa fuente e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impossible d'appliquer : la copie en cache de « %@ » ne correspond pas à sa somme de contrôle vérifiée (elle est peut-être corrompue ou a été modifiée). Actualisez cette source, puis réessayez."
          }
        }
      }
    },
    "validator.wildcardInvalid" : {
      "comment" : "Validator warning for a malformed wildcard hostname. %@ is the hostname.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invalid wildcard: %@. Use the form *.name.test"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invalid wildcard: %@. Use the form *.name.test"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comodín no válido: %@. Usa la forma *.nombre.test"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Joker non valide : %@. Utilisez la forme *.nom.test"
          }
        }
      }
    },
    "validator.wildcardMixed" : {
      "comment" : "Validator warning when a wildcard shares its line with other hostnames.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A wildcard must be the only name on its line"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A wildcard must be the only name on its line"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un comodín debe ser el único nombre de su línea"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un joker doit être le seul nom de sa ligne"
          }
        }
      }
    },
    "validator.wildcardNotAllowed" : {
      "comment" : "Validator warning for a wildcard hostname outside .test and .internal. %@ is the hostname.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wildcards only work under .test and .internal: %@"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wildcards only work under .test and .internal: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los comodines solo funcionan bajo .test y .internal: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les jokers ne fonctionnent que sous .test et .internal : %@"
          }
        }
      }
    },
    "validator.wildcardOverride" : {
      "comment" : "Validator warning when an explicit hostname maps to a different address than the wildcard covering it. First %@ is the hostname, second is the wildcard.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ overrides %2$@"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ overrides %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ sustituye a %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ remplace %2$@"
          }
        }
      }
    },
    "validator.wildcardTooBroad" : {
      "comment" : "Validator warning for a wildcard that covers the whole .internal top-level domain. %@ is the hostname.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ would catch every .internal name. Use a name below it, such as *.app.internal"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ would catch every .internal name. Use a name below it, such as *.app.internal"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ capturaría todos los nombres .internal. Usa un nombre por debajo, como *.app.internal"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ capterait tous les noms en .internal. Utilisez un nom en dessous, comme *.app.internal"
          }
        }
      }
    }
  },
  "version" : "1.0"
